<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed: the beta packages packed from the huml-dotnet repo during development and CI.
         Once 0.2.0-beta.1 is published, CI can drop the local pack step and rely on nuget.org. -->
    <add key="local" value="local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
