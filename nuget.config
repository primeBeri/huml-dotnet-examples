<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local feed: used by CI's pack-from-source mode and for local development against an
         unpublished Huml.Net build (pack into local-feed/ with a distinct version, then run
         ./run-examples.ps1 -HumlNetVersion <that version>). Published versions come from
         nuget.org. NuGet errors (NU1301) if a declared folder source is missing, so CI
         creates the directory even when it is unused. -->
    <add key="local" value="local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
